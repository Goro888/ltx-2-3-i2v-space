# LTX 2.3 I2V Space Configuration

# Hugging Face API Token
HF_TOKEN=your_hf_token_here

# ComfyUI Server Configuration
COMFYUI_SERVER=http://localhost:8188

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=7860

# Generation Defaults
DEFAULT_DURATION=10
MAX_DURATION=42
DEFAULT_RESOLUTION_WIDTH=848
DEFAULT_RESOLUTION_HEIGHT=480

# Model Configuration
MODEL_NAME=LTX-Video-v2.3-fp8-mixed
MODEL_PRECISION=fp8

# Preset Configurations
PRESET_CINEMATIC_STEPS=50
PRESET_SMOOTH_MOTION_STEPS=40
PRESET_HIGH_QUALITY_STEPS=60
PRESET_FAST_STEPS=25
PRESET_EXPERIMENTAL_STEPS=55

# Quality Settings
MIN_GUIDANCE_SCALE=1.0
MAX_GUIDANCE_SCALE=20.0
DEFAULT_GUIDANCE_SCALE=7.5

# Audio Configuration
ENABLE_AUDIO_BY_DEFAULT=true
TTS_MODEL=tts-1-hd
TTS_VOICE=alloy

# ZeroGPU Configuration
MAX_GENERATIONS=-1
ENABLE_RATE_LIMITING=false
QUEUE_TIMEOUT=600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ltx_space.log

# Policy Compliance
ENABLE_POLICY_CHECK=true
STRICT_POLICY_MODE=true

# Cache Settings
ENABLE_CACHE=true
CACHE_DIR=/tmp/ltx_cache
MAX_CACHE_SIZE_GB=10

# Development
DEBUG_MODE=false
ENABLE_PROFILING=false
